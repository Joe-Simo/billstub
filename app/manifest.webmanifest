  "shortcuts": [
    {
      "name": "New bill",
      "short_name": "New bill",
      "url": "/billstub/app/?new",
      "icons": [
        {
          "src": "icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "widgets": [
    {
      "name": "Billstub: Next bills",
      "short_name": "Next bills",
      "description": "Your next bills, when they are due, and how much.",
      "tag": "next-bills",
      "template": "billstub-next-bills",
      "ms_ac_template": "widgets/next-bills.ac.json",
      "data": "widgets/next-bills-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "widgets/screenshot-next-bills.png",
          "sizes": "600x400",
          "label": "The Next bills widget"
        }
      ],
      "icons": [
        {
          "src": "icons/icon-48.png",
          "sizes": "48x48"
        }
      ],
      "auth": false,
      "update": 21600,
      "multiple": false
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
