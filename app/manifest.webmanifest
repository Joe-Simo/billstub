{
  "id": "/billstub/app/",
  "name": "Billstub",
  "short_name": "Billstub",
  "description": "A calm bill due-date tracker for Windows. See what is due next, mark bills paid, and keep everything on this PC.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/billstub/app/",
  "scope": "/billstub/app/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "theme_color": "#233a5b",
  "background_color": "#eef0f4",
  "categories": [
    "finance",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "icons/icon-16.png",
      "sizes": "16x16",
      "type": "image/png",
      "purpose": "any"
    },
